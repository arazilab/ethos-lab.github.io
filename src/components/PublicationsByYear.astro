---
import { publicationDownloads } from '../content/publicationDownloads.js';
const { years } = Astro.props;
---
<div class="publication-years">
  {years.map((group) => (
    <section class="publication-year" aria-labelledby={`year-${group.year}`}>
      <h2 id={`year-${group.year}`}>{group.year}</h2>
      <ol>
        {group.items.map((item) => (
          <li>
            <p>{item.authors}. {item.title}. <em>{item.venue}</em>.</p>
            <div class="publication-links">
              {item.url && <a href={item.url}>{item.url.startsWith('https://doi.org/') ? `DOI: ${item.url}` : 'Publication link'}</a>}
              {publicationDownloads[item.url ?? item.title] && <a href={publicationDownloads[item.url ?? item.title]}>Download</a>}
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}
</div>

<style>
  .publication-links { display: flex; flex-wrap: wrap; gap: .4rem 1.2rem; }
  .publication-links a { overflow-wrap: anywhere; }
</style>

<!-- Add publication details in src/content/publications.js and access links in publicationDownloads.js. -->

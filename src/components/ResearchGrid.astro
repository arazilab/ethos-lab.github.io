---
const { areas } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<div class="research-grid">
  {areas.map((area) => (
    <article class="research-item">
      <span class="research-mark" aria-hidden="true"></span>
      <h2><a href={`${base}research/${area.slug}/`}>{area.title}</a></h2>
      <p>{area.description}</p>
    </article>
  ))}
</div>

<style>
  .research-item h2 a { color: inherit; text-decoration-color: var(--teal); text-underline-offset: .15em; }
  .research-item h2 a:hover { color: var(--teal); }
</style>


---
import { site } from '../content/site.js';
const { title = site.name, description = site.mission } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const path = Astro.url.pathname.replace(base, '/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} | ETHOS Lab</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label="ETHOS Lab home"><span class="wordmark-symbol">E</span><span>ETHOS <small>LAB</small></span></a>
      <nav aria-label="Main navigation">
        {site.navigation.map((item) => {
          const href = item.href === '/' ? base : `${base}${item.href.slice(1)}`;
          const current = item.href === '/' ? path === '/' : path.startsWith(item.href);
          return <a href={href} aria-current={current ? 'page' : undefined}>{item.label}</a>;
        })}
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-brand"><a class="wordmark" href={base}><span class="wordmark-symbol">E</span><span>ETHOS <small>LAB</small></span></a><p>{site.fullName}</p></div>
      <div><h2>Visit us</h2>{site.address.map((line) => <p>{line}</p>)}</div>
      <div><h2>Get in touch</h2><a href={site.contactUrl}>Contact the lab</a></div>
      <p class="copyright">© {new Date().getFullYear()} ETHOS Lab · Drexel University</p>
    </footer>
  </body>
</html>

<style is:global>
  :root { font-family: 'DM Sans', sans-serif; color: #18282d; background: #fff; font-synthesis: none; text-rendering: optimizeLegibility; --ink: #18282d; --muted: #53666a; --teal: #087d78; --mint: #dff3ed; --line: #dce5e3; --paper: #f5f8f6; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; min-width: 320px; }
  a { color: #08756e; text-underline-offset: 0.18em; }
  a:hover { color: #064c48; }
  a:focus-visible { outline: 3px solid #d1643b; outline-offset: 4px; border-radius: 2px; }
  h1, h2, h3 { font-family: 'Manrope', sans-serif; letter-spacing: -0.035em; color: var(--ink); }
  p { line-height: 1.75; }
  .skip-link { position: absolute; left: -999px; top: 1rem; background: white; padding: .75rem 1rem; z-index: 5; }
  .skip-link:focus { left: 1rem; }
  .site-header { max-width: 1240px; margin: 0 auto; padding: 1.1rem 2rem; min-height: 86px; display: flex; align-items: center; justify-content: space-between; gap: 2rem; border-bottom: 1px solid var(--line); }
  .wordmark { display: inline-flex; align-items: center; gap: .65rem; text-decoration: none; color: var(--ink); font: 800 1.06rem 'Manrope', sans-serif; letter-spacing: .06em; white-space: nowrap; }
  .wordmark small { display: block; font: 600 .62rem 'DM Sans', sans-serif; letter-spacing: .32em; color: var(--muted); }
  .wordmark-symbol { width: 38px; height: 38px; display: grid; place-items: center; color: white; background: var(--teal); border-radius: 50% 50% 50% 10%; font: 800 1.1rem 'Manrope', sans-serif; }
  nav { display: flex; align-items: center; gap: clamp(1rem, 3vw, 2.5rem); }
  nav a { color: var(--ink); text-decoration: none; font-size: .91rem; font-weight: 600; padding: .55rem 0; border-bottom: 2px solid transparent; }
  nav a[aria-current="page"] { color: var(--teal); border-color: var(--teal); }
  main { min-height: 55vh; }
  .page-shell { max-width: 1120px; margin: 0 auto; padding: 5rem 2rem 7rem; }
  .section-intro { max-width: 760px; margin-bottom: 3.4rem; }
  .section-intro h1 { font-size: clamp(2.5rem, 6vw, 4.65rem); line-height: 1.05; margin: .4rem 0 1.2rem; }
  .eyebrow { color: var(--teal); font-size: .78rem; letter-spacing: .16em; text-transform: uppercase; font-weight: 700; }
  .intro-copy { font-size: 1.14rem; color: var(--muted); max-width: 66ch; }
  .site-footer { background: var(--paper); border-top: 1px solid var(--line); padding: 3.5rem max(2rem, calc((100% - 1120px) / 2)); display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 2.5rem; color: var(--muted); }
  .site-footer h2 { font-size: .95rem; margin: 0 0 .75rem; }
  .site-footer p { margin: .2rem 0; font-size: .9rem; }
  .footer-brand p { max-width: 240px; }
  .copyright { grid-column: 1 / -1; border-top: 1px solid var(--line); padding-top: 1.2rem; margin-top: .5rem !important; font-size: .8rem !important; }
  .home-hero { background: #eef7f4; border-bottom: 1px solid var(--line); }
  .hero-inner { max-width: 1120px; margin: 0 auto; padding: clamp(4rem, 9vw, 8rem) 2rem; display: grid; grid-template-columns: 1.15fr .85fr; align-items: center; gap: 4rem; }
  .hero-inner h1 { font-size: clamp(3.3rem, 7.5vw, 6.8rem); line-height: .98; max-width: 8ch; margin: .6rem 0 1.5rem; }
  .hero-inner p { max-width: 58ch; color: #40575b; font-size: 1.1rem; }
  .hero-art { min-height: 340px; position: relative; display: grid; place-items: center; }
  .orbit { position: absolute; border: 1px solid rgba(8,125,120,.25); border-radius: 50%; width: min(29vw, 360px); aspect-ratio: 1; }
  .orbit:nth-child(2) { width: min(22vw, 270px); border-style: dashed; }
  .orbit-core { width: min(16vw, 200px); min-width: 150px; aspect-ratio: 1; border-radius: 50% 50% 50% 8%; background: var(--teal); color: white; display: grid; place-items: center; text-align: center; padding: 1.5rem; font: 700 1.2rem 'Manrope', sans-serif; box-shadow: 16px 16px 0 #b8dfd5; }
  .home-section { max-width: 1120px; padding: 5rem 2rem; margin: 0 auto; }
  .home-section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2rem; }
  .home-section-heading h2 { font-size: clamp(2rem, 4vw, 3rem); margin: 0; }
  .home-section-heading a { font-weight: 700; }
  .research-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem; }
  .research-item { border-top: 1px solid var(--line); padding-top: 1.4rem; }
  .research-mark { width: 38px; height: 8px; display: block; margin-bottom: 1.2rem; background: var(--teal); border-radius: 0 8px 8px 0; }
  .research-item:nth-child(2) .research-mark { background: #dc774b; }
  .research-item:nth-child(3) .research-mark { background: #688a46; }
  .research-item h2 { font-size: 1.4rem; margin: 0 0 .7rem; }
  .research-item p { color: var(--muted); margin: 0; }
  .team-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; }
  .person { display: grid; grid-template-columns: 62px 1fr; align-items: start; gap: 1.1rem; padding: 1.5rem 0; border-top: 1px solid var(--line); }
  .person-monogram { width: 58px; height: 58px; border-radius: 50% 50% 50% 10%; display: grid; place-items: center; background: var(--mint); color: var(--teal); font: 700 1rem 'Manrope', sans-serif; }
  .person h2 { margin: 0; font-size: 1.25rem; }
  .person h2 a { color: inherit; text-decoration: none; }
  .person-role { margin: .2rem 0 .7rem; color: var(--teal); font-size: .85rem; font-weight: 700; }
  .person p { margin: .5rem 0; color: var(--muted); }
  .interest-list { font-size: .88rem; }
  .publication-year { display: grid; grid-template-columns: 110px 1fr; gap: 1.5rem; border-top: 1px solid var(--line); padding: 1.6rem 0; }
  .publication-year h2 { margin: 0; font-size: 1.45rem; color: var(--teal); }
  .publication-year ol { margin: 0; padding: 0; list-style: none; }
  .publication-year li { padding: 0 0 1.3rem; margin-bottom: 1.3rem; border-bottom: 1px solid #edf1ef; }
  .publication-year li:last-child { border: 0; margin: 0; padding: 0; }
  .publication-year li p { margin: 0 0 .45rem; }
  .publication-year li a { font-size: .88rem; font-weight: 600; }
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }
  .contact-block { border-top: 1px solid var(--line); padding-top: 1.2rem; }
  .contact-block h2 { font-size: 1.3rem; }
  .contact-block p { color: var(--muted); }
  @media (max-width: 760px) {
    .site-header { align-items: flex-start; flex-direction: column; padding: 1rem 1.25rem; gap: .7rem; }
    nav { width: 100%; gap: 1.3rem; overflow-x: auto; }
    nav a { flex: 0 0 auto; font-size: .86rem; }
    .page-shell { padding: 3.5rem 1.25rem 5rem; }
    .hero-inner { grid-template-columns: 1fr; gap: 1rem; padding: 4rem 1.25rem 2rem; }
    .hero-art { min-height: 230px; }
    .orbit { width: 230px; }
    .orbit:nth-child(2) { width: 175px; }
    .orbit-core { width: 130px; min-width: 130px; font-size: 1rem; }
    .home-section { padding: 3.5rem 1.25rem; }
    .research-grid, .team-grid, .contact-grid { grid-template-columns: 1fr; }
    .research-grid { gap: 1.5rem; }
    .publication-year { grid-template-columns: 1fr; gap: .6rem; }
    .site-footer { grid-template-columns: 1fr; padding: 2.5rem 1.25rem; gap: 1.5rem; }
    .copyright { grid-column: auto; }
  }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
</style>

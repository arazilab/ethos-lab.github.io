---
import SiteLayout from '../layouts/SiteLayout.astro';
import SectionIntro from '../components/SectionIntro.astro';
import { site } from '../content/site.js';
const embedUrl = `${site.contactFormUrl}&embedded=true`;
---
<SiteLayout title="Contact">
  <div class="page-shell">
    <SectionIntro eyebrow="Connect with us" title="Contact ETHOS Lab" intro="We welcome conversations with students, researchers, and community partners." />
    <div class="contact-grid">
      <section class="contact-block"><h2>Visit us</h2>{site.address.map((line) => <p>{line}</p>)}<a href="https://maps.google.com/?q=3675+Market+St,+Philadelphia,+PA+19104">View location</a></section>
      <section class="contact-block"><h2>Social media</h2><p><a href={site.linkedinUrl}>LinkedIn</a></p></section>
    </div>
    <section class="contact-form" aria-labelledby="contact-form-title">
      <h2 id="contact-form-title">Send us a message</h2>
      <p>If the form does not load, <a href={site.contactFormUrl}>open the Google Form directly</a>.</p>
      <iframe src={embedUrl} title="ETHOS Lab contact form" loading="lazy">Loading contact form…</iframe>
    </section>
  </div>
</SiteLayout>

<style>
  .contact-form { margin-top: 3rem; border-top: 1px solid var(--line); padding-top: 1.5rem; }
  .contact-form h2 { font-size: 1.6rem; }
  .contact-form p { color: var(--muted); }
  .contact-form iframe { display: block; width: 100%; min-height: 900px; border: 0; }
</style>
